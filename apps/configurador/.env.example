NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# The integrated AGAMA container also accepts the existing web env names:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional HTTPS endpoint that receives a quote notification after storage.
# If omitted, the configurador falls back to:
#   ${NEXT_PUBLIC_SUPABASE_URL}/functions/v1/notify-contact
AGAMA_SALES_WEBHOOK_URL=https://<sales-webhook>
